# Increase volume
"volume-control up"
   XF86AudioRaiseVolume

# Decrease volume
"volume-control down"
   XF86AudioLowerVolume

# Mute volume
"volume-control mute"
   XF86AudioMute

# Mute microphone
"pactl set-source-mute @DEFAULT_SOURCE@ toggle"
   XF86AudioMicMute

#BrightnessUp
"brightness-control up"
   c:233
   XF86MonBrightnessUp

#BrightnessDown
"brightness-control down"
   c:232
   XF86MonBrightnessDown
